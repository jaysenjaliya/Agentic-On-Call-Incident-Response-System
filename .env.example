# ============================================================================
#  Agentic Incident Response System — Environment Configuration (TEMPLATE)
# ----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#      cp .env.example .env
#  NEVER put real keys in THIS file — it is committed to git.
# ============================================================================

# ---- LLM provider selection ----
# "openai" (per PRD §2.3, the eventual target) or "groq" (temporary, see ADR-0009).
LLM_PROVIDER=groq

# ---- OpenAI (target provider; locked by PRD §2.3) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano

# ---- Groq (temporary provider — OpenAI-compatible, fast) ----
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b

# ---- LangSmith tracing (NFR-1; enabled in Phase 3) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=agentic-incident-response
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- Gmail MCP escalation (Phase 3, WI-32) — see docs/GMAIL_MCP_SETUP.md ----
# Real emails send only when RUN_MODE=prod AND GMAIL_MCP_ENABLED=true.
# Otherwise the mock notifier is used (nothing is sent).
ESCALATION_EMAIL_TO=oncall@example.com
GMAIL_MCP_ENABLED=false
GMAIL_MCP_COMMAND=npx
GMAIL_MCP_ARGS=-y @gongrzhe/server-gmail-autoauth-mcp
GMAIL_MCP_SEND_TOOL=send_email

# ---- HTTP server (deploy/ + server/, see docs/DEPLOYMENT.md) ----
# If set, every API request must send this value in an X-API-Key header.
# Leave unset/empty for open access on a trusted LAN.
SERVER_API_KEY=

# ---- Runtime mode ----
# "mock"  -> use mock notification/tools only (default, no external calls)
# "prod"  -> use real MCP tools where configured
RUN_MODE=mock
