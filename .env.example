# ============================================================================
#  Agentic Incident Response System — Environment Configuration (TEMPLATE)
# ----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#      cp .env.example .env
#  NEVER put real keys in THIS file — it is committed to git.
# ============================================================================

# ---- LLM provider selection ----
# "openai" (per PRD §2.3, the eventual target) or "groq" (temporary, see ADR-0009).
LLM_PROVIDER=groq

# ---- OpenAI (target provider; locked by PRD §2.3) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano

# ---- Groq (temporary provider — OpenAI-compatible, fast) ----
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ---- LangSmith tracing (NFR-1; enabled in Phase 3) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=agentic-incident-response
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- Gmail MCP escalation (Phase 3, WI-32) ----
# If unset or MCP unavailable, the system falls back to MockNotificationService
# and documents the fallback (per PRD §7.2 risk mitigation).
ESCALATION_EMAIL_TO=oncall@example.com
GMAIL_MCP_ENABLED=false

# ---- Runtime mode ----
# "mock"  -> use mock notification/tools only (default, no external calls)
# "prod"  -> use real MCP tools where configured
RUN_MODE=mock
