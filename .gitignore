# ---- Secrets / environment ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- uv ----
# uv.lock IS committed (reproducible builds); the cache is not.
.uv/

# ---- Tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- LangGraph / LangSmith / checkpointing ----
*.sqlite
*.sqlite3
*.db
checkpoints/

# ---- Runtime data (generated by the agent) ----
# These directories are tracked (via .gitkeep) but their generated contents are not.
data/audit_trail/*
!data/audit_trail/.gitkeep
data/dlq/*
!data/dlq/.gitkeep

# ---- Claude Code (local, per-user) ----
# Shared config (.claude/settings.json, .claude/skills/) IS tracked; local overrides are not.
.claude/settings.local.json

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- Scratch ----
_prd_extracted.txt
scratch/
